{
	"name": "finals-roulette",
	"private": true,
	"scripts": {
		"build": "turbo run build --filter=web --filter=@repo/ui --filter=@repo/roulette",
		"dev": "turbo run dev --filter=web --filter=@repo/ui --filter=@repo/roulette",
		"lint": "turbo run lint --filter=web --filter=@repo/ui --filter=@repo/roulette",
		"format": "prettier --write \"**/*.{ts,tsx,md}\"",
		"check-types": "turbo run check-types --filter=web --filter=@repo/ui --filter=@repo/roulette"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.8",
		"prettier": "^3.6.2",
		"turbo": "^2.8.21",
		"typescript": "5.9.2"
	},
	"packageManager": "pnpm@10.33.0",
	"engines": {
		"node": ">=24"
	}
}
